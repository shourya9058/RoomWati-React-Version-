# ==========================================
# RoomWati Backend Environment Configuration
# ==========================================

# Server Environment
NODE_ENV=production
PORT=8080

# MongoDB Atlas Database URI
ATLASDB_URL="mongodb+srv://<username>:<password>@cluster0.yourcluster.mongodb.net/roomwati?retryWrites=true&w=majority"

# Session Secret (min 32 random characters)
SECRET="your_secure_random_session_secret_key_here"

# Cloudinary Media Storage
CLOUD_NAME="your_cloudinary_cloud_name"
CLOUD_API_KEY="your_cloudinary_api_key"
CLOUD_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_FOLDER="Roomwati_PROD"

# EmailJS Service Configuration (Single Template: roomwati_otp)
EMAILJS_SERVICE_ID="your_emailjs_service_id"
EMAILJS_TEMPLATE_ID="roomwati_otp"
EMAILJS_PUBLIC_KEY="your_emailjs_public_key"
EMAILJS_PRIVATE_KEY="your_emailjs_private_key"

# Production Cross-Origin (CORS) & Frontend Domain
FRONTEND_URL="https://your-production-frontend-domain.vercel.app"
ALLOWED_ORIGINS="https://your-production-frontend-domain.vercel.app"

# ==========================================
# RoomWati Frontend Environment (Vite)
# ==========================================
# Set this in Vercel Environment Variables or client/.env.production
# VITE_API_URL="https://api.yourdomain.com"

